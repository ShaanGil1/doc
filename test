# eq
post("doc_metadata", {
    "conditions": [
        {"field": "document_type", "op": "eq", "value": "report"}
    ]
})

# gte + eq combined
post("doc_metadata", {
    "conditions": [
        {"field": "fiscal_year", "op": "gte", "value": 2020},
        {"field": "document_type", "op": "eq", "value": "report"}
    ]
})

# real JSON bool — note: true (lowercase), not "true"
post("doc_metadata", {
    "conditions": [
        {"field": "is_latest", "op": "eq", "value": True}
    ]
})

# IN with real ints
post("doc_metadata", {
    "conditions": [
        {"field": "fiscal_year", "op": "in", "value": [2020, 2021, 2022]}
    ]
})

# date range
post("doc_metadata", {
    "conditions": [
        {"field": "document_created", "op": "gte", "value": "2023-01-01"},
        {"field": "document_created", "op": "lt", "value": "2024-01-01"}
    ]
})

# ilike with custom return_cols and limit
post("doc_metadata", {
    "conditions": [
        {"field": "document_name", "op": "ilike", "value": "%climate%"}
    ],
    "return_cols": ["document_id", "document_name"],
    "limit": 10
})

# not_in
post("doc_metadata", {
    "conditions": [
        {"field": "document_type", "op": "not_in", "value": ["draft", "archived"]}
    ]
})

# uuid lookup
post("doc_metadata", {
    "conditions": [
        {"field": "document_id", "op": "eq", "value": "11111111-1111-1111-1111-111111111111"}
    ]
})

# full-text
post("doc_metadata", {
    "conditions": [
        {"field": "search", "op": "matches", "value": "climate policy"}
    ]
})

# is_empty — omit value entirely, or pass null
post("doc_metadata", {
    "conditions": [
        {"field": "dates_referenced", "op": "is_empty"}
    ]
})

# not_empty
post("doc_metadata", {
    "conditions": [
        {"field": "dates_referenced", "op": "not_empty"}
    ]
})

# contains_any (overlap) — row matches if ANY of these appear in entities
post("chunk_metadata", {
    "conditions": [
        {"field": "entities", "op": "contains_any", "value": ["epa", "noaa"]}
    ]
})

# contains_all (superset) — row must contain EVERY element
post("chunk_metadata", {
    "conditions": [
        {"field": "entities", "op": "contains_all", "value": ["epa", "noaa"]}
    ]
})

# contains_none
post("chunk_metadata", {
    "conditions": [
        {"field": "entities", "op": "contains_none", "value": ["draft", "archived"]}
    ]
})

# key_phrases contains_any
post("chunk_metadata", {
    "conditions": [
        {"field": "key_phrases", "op": "contains_any", "value": ["climate", "policy"]}
    ]
})

# chunks from latest reports mentioning EPA
post("chunk_metadata", {
    "conditions": [
        {"field": "entities", "op": "contains_any", "value": ["epa"]},
        {"field": "parent_document_type", "op": "eq", "value": "report"},
        {"field": "is_latest", "op": "eq", "value": True}
    ],
    "return_cols": ["chunk_id", "document_id", "content_summary"],
    "limit": 25
})

# chunks by parent document
post("chunk_metadata", {
    "conditions": [
        {"field": "document_id", "op": "eq", "value": "11111111-1111-1111-1111-111111111111"}
    ]
})

# simple topic type
post("fact_table", {
    "conditions": [
        {"field": "topic_type", "op": "eq", "value": "policy"}
    ]
})

# high-confidence recent topics
post("fact_table", {
    "conditions": [
        {"field": "topic_fiscal_year", "op": "gte", "value": 2022},
        {"field": "topic_confidence", "op": "gte", "value": 80}
    ]
})

# big combined
post("fact_table", {
    "conditions": [
        {"field": "topic_fiscal_year", "op": "gte", "value": 2022},
        {"field": "topic_type", "op": "in", "value": ["policy", "regulation"]},
        {"field": "authority_level", "op": "neq", "value": "draft"},
        {"field": "is_latest", "op": "eq", "value": True}
    ],
    "return_cols": ["topic_id", "topic", "topic_type", "authority_level"],
    "limit": 50
})

# date range on start/end
post("fact_table", {
    "conditions": [
        {"field": "start_date", "op": "gte", "value": "2023-01-01"},
        {"field": "end_date", "op": "lt", "value": "2024-01-01"}
    ]
})

# unknown field
post("doc_metadata", {
    "conditions": [{"field": "ghost_field", "op": "eq", "value": "x"}]
})

# missing 'field' key
post("doc_metadata", {
    "conditions": [{"op": "eq", "value": "report"}]
})

# op not allowed on type (like on int)
post("doc_metadata", {
    "conditions": [{"field": "fiscal_year", "op": "like", "value": "20%"}]
})

# can't coerce
post("doc_metadata", {
    "conditions": [{"field": "fiscal_year", "op": "gte", "value": "not a number"}]
})

# body not an object
post("doc_metadata", [])

# non-int limit
post("doc_metadata", {"limit": "20"})

# return_cols not a list
post("doc_metadata", {"return_cols": "document_id"})

# can't return a tsvector field
post("doc_metadata", {
    "conditions": [],
    "return_cols": ["search"]
})

# unknown table
post("wrong_table", {"conditions": []})

# Simulate a page of results mid-way through a larger set
result = post(
    "doc_metadata",
    {
        "conditions": [{"field": "document_type", "op": "eq", "value": "report"}],
        "limit": 10,
        "offset": 20,
    },
    rows=[
        {"document_id": "11111111-1111-1111-1111-111111111111", "document_name": "Report A", "document_type": "report", "fiscal_year": 2023},
        {"document_id": "22222222-2222-2222-2222-222222222222", "document_name": "Report B", "document_type": "report", "fiscal_year": 2024},
    ],
    total=100,
)
print("RESPONSE:", result)
# expect: total=100, limit=10, offset=20, next_offset=30, 2 results
