def fmt_run(run):
    if not run:
        return ""
    bits = []
    fonts = run.get("fonts") or {}
    font = fonts.get("ascii") or fonts.get("asciiTheme")
    if font:
        bits.append(font)
    if run.get("size_pt"):
        bits.append("%gpt" % run["size_pt"])
    for flag in ("bold", "italic", "caps", "smallCaps", "strike"):
        if run.get(flag):
            bits.append(flag)
    if run.get("underline"):
        bits.append("underline")
    if (run.get("color") or {}).get("rgb"):
        bits.append("#" + run["color"]["rgb"])
    if run.get("charStyle"):
        bits.append("char:" + run["charStyle"])
    return ", ".join(bits)


def fmt_para(para):
    if not para:
        return ""
    bits = []
    if para.get("align"):
        bits.append("align=" + para["align"])
    sp = para.get("spacing") or {}
    if sp.get("before_pt") is not None:
        bits.append("before=%gpt" % sp["before_pt"])
    if sp.get("after_pt") is not None:
        bits.append("after=%gpt" % sp["after_pt"])
    if sp.get("line_multiple"):
        bits.append("line=%gx" % sp["line_multiple"])
    elif sp.get("line") and sp.get("lineRule") in ("exact", "atLeast"):
        bits.append("line=%gpt %s" % (sp["line"] / 20.0, sp["lineRule"]))
    ind = para.get("indent") or {}
    for key, label in (("left_in", "left"), ("firstLine_in", "first"),
                       ("hanging_in", "hanging"), ("right_in", "right")):
        if ind.get(key) is not None:
            bits.append("%s=%.2f\"" % (label, ind[key]))
    for flag in ("keepNext", "keepLines", "pageBreakBefore", "contextualSpacing"):
        if para.get(flag):
            bits.append(flag)
    if para.get("outlineLvl") is not None:
        bits.append("outline=%d" % para["outlineLvl"])
    if para.get("numPr"):
        bits.append("numId=%s/ilvl=%s" % (para["numPr"].get("numId"),
                                          para["numPr"].get("ilvl")))
    if para.get("shading", {}).get("fill") not in (None, "auto"):
        bits.append("fill=#" + para["shading"]["fill"])
    if para.get("borders"):
        bits.append("borders(%s)" % ",".join(sorted(para["borders"])))
    return ", ".join(bits)


def build_report(data, src_name):
    L = []
    add = L.append

    add("# Template extraction: %s" % src_name)
    add("")
    add("Generated by template_extract.py. Redaction mode: **%s**." % data["meta"]["redaction"])
    add("")

    # ---- quick answers -----------------------------------------------------
    add("## 1. Quick answers")
    add("")
    sects = data.get("sections") or []
    if sects:
        s0 = sects[0]
        page = s0.get("page") or {}
        mar = s0.get("margins_in") or {}
        add("- Page: %s x %s in, %s" % (page.get("width_in"), page.get("height_in"),
                                        page.get("orient")))
        add("- Margins in: top %s, bottom %s, left %s, right %s (header %s, footer %s)" % (
            mar.get("top"), mar.get("bottom"), mar.get("left"), mar.get("right"),
            mar.get("header"), mar.get("footer")))
        add("- Different first page: %s" % s0.get("different_first_page"))
        add("- Section count in body: %d" % len(sects))
    dd = (data.get("styles") or {}).get("doc_defaults") or {}
    add("- Document default run: %s" % (fmt_run(dd.get("run")) or "not set"))
    add("- Document default paragraph: %s" % (fmt_para(dd.get("paragraph")) or "not set"))
    theme = data.get("theme") or {}
    if theme.get("fonts"):
        add("- Theme fonts: major=%s, minor=%s" % (
            (theme["fonts"].get("major") or {}).get("latin"),
            (theme["fonts"].get("minor") or {}).get("latin")))
    add("- Style count: %d (%d custom)" % (
        len(data["styles"].get("styles", [])),
        sum(1 for s in data["styles"].get("styles", []) if s.get("custom"))))
    numbering = data.get("numbering") or {}
    add("- Numbering: %d abstract definitions, %d num instances" % (
        len(numbering.get("abstract_definitions", [])),
        len(numbering.get("instances", []))))
    add("- Header/footer parts: %d" % len(data.get("headers_footers", [])))
    add("- Images in package: %d" % len(data.get("media", [])))
    stats = data.get("body_stats", {})
    add("- Body paragraphs: %d, of which %d carry direct formatting on top of "
        "their style (%s%%)" % (stats.get("paragraphs", 0),
                                stats.get("hand_formatted", 0),
                                stats.get("hand_formatted_pct", 0)))
    add("")
    add("> That last number is the one to look at. Low means the template is "
        "style driven and a config file will carry it cleanly. High means "
        "whoever built it formatted by hand and some rules will have to be "
        "reverse engineered from the body rather than read off the styles.")
    add("")

    # ---- styles ------------------------------------------------------------
    add("## 2. Styles")
    add("")
    used = set(data.get("style_usage", {}).keys())
    for kind, label in (("paragraph", "Paragraph styles"),
                        ("character", "Character styles"),
                        ("table", "Table styles"),
                        ("numbering", "Numbering styles")):
        entries = [s for s in data["styles"].get("styles", []) if s.get("type") == kind]
        if not entries:
            continue
        add("### %s (%d)" % (label, len(entries)))
        add("")
        add("| id | name | based on | next | used | paragraph | run |")
        add("|---|---|---|---|---|---|---|")
        for s in sorted(entries, key=lambda x: (not x.get("custom"), x.get("name") or "")):
            add("| `%s` | %s%s | %s | %s | %s | %s | %s |" % (
                s.get("id"),
                s.get("name"),
                " **(custom)**" if s.get("custom") else "",
                s.get("basedOn") or "",
                s.get("next") or "",
                data.get("style_usage", {}).get(s.get("id"), 0),
                fmt_para(s.get("paragraph")),
                fmt_run(s.get("run")),
            ))
        add("")

    resolved = data.get("resolved_headings") or {}
    if resolved:
        add("### Heading styles, resolved down the basedOn chain")
        add("")
        add("| style | paragraph | run |")
        add("|---|---|---|")
        for sid, merged in resolved.items():
            add("| `%s` | %s | %s |" % (sid, fmt_para(merged.get("paragraph")),
                                        fmt_run(merged.get("run"))))
        add("")

    # ---- numbering ---------------------------------------------------------
    add("## 3. Numbering and list cascades")
    add("")
    for ab in numbering.get("abstract_definitions", []):
        add("### abstractNumId %s%s" % (ab.get("abstractNumId"),
                                        " (%s)" % ab["name"] if ab.get("name") else ""))
        add("")
        add("- multiLevelType: %s" % ab.get("multiLevelType"))
        if ab.get("styleLink"):
            add("- styleLink: %s  (this definition IS a numbering style)" % ab["styleLink"])
        if ab.get("numStyleLink"):
            add("- numStyleLink: %s  (defers to another definition)" % ab["numStyleLink"])
        if ab.get("linked_styles"):
            add("- levels tied to paragraph styles: %s  <-- auto numbering, "
                "you write the text and Word writes the number"
                % ", ".join(ab["linked_styles"]))
        instances = [n["numId"] for n in numbering.get("instances", [])
                     if n.get("abstractNumId") == ab.get("abstractNumId")]
        add("- referenced by numId: %s" % (instances or "none"))
        add("")
        add("| lvl | format | lvlText | renders as | start | restart | left | hanging | linked style | marker font |")
        add("|---|---|---|---|---|---|---|---|---|---|")
        for lv in ab.get("levels", []):
            ind = lv.get("indent") or {}
            add("| %s | %s | `%s` | %s | %s | %s | %s | %s | %s | %s |" % (
                lv.get("ilvl"), lv.get("numFmt"), lv.get("lvlText"),
                render_marker(lv), lv.get("start"),
                lv.get("restart_after_lvl", ""),
                ind.get("left_in"), ind.get("hanging_in"),
                lv.get("linked_pStyle") or "", lv.get("marker_font") or ""))
        add("")

    overrides = [n for n in numbering.get("instances", []) if n.get("overrides")]
    if overrides:
        add("### numId instances with level overrides")
        add("")
        for n in overrides:
            add("- numId %s -> abstract %s: %s" % (
                n["numId"], n.get("abstractNumId"),
                ", ".join("ilvl %s startOverride=%s" % (o.get("ilvl"), o.get("startOverride"))
                          for o in n["overrides"])))
        add("")

    # ---- sections ----------------------------------------------------------
    add("## 4. Page setup / sectPr")
    add("")
    add("```json")
    add(json.dumps(sects, indent=2))
    add("```")
    add("")

    # ---- headers footers ---------------------------------------------------
    add("## 5. Headers and footers")
    add("")
    if not data.get("headers_footers"):
        add("None.")
        add("")
    for part in data.get("headers_footers", []):
        add("### %s (%s)" % (part["part"], part["kind"]))
        add("")
        for block in part["blocks"]:
            if block.get("kind") == "paragraph":
                desc = "`%s`" % block.get("style_id")
                if block.get("fields"):
                    desc += "  fields: %s" % "; ".join(block["fields"])
                if block.get("images"):
                    desc += "  IMAGE: %s" % ", ".join(
                        str(i.get("target")) for i in block["images"])
                add("- %s  %s" % (desc, json.dumps(block.get("text", ""))))
            elif block.get("kind") == "table":
                add("- table %sx%s, style %s" % (
                    block.get("row_count"), block.get("col_count"),
                    (block.get("props") or {}).get("style")))
        add("")

    # ---- images ------------------------------------------------------------
    add("## 6. Images")
    add("")
    if data.get("media"):
        for m in data["media"]:
            add("- `%s`, %d bytes%s" % (m["part"], m["bytes"],
                                        ", saved to %s" % m["saved_to"] if m.get("saved_to") else ""))
        add("")
    for img in data.get("image_placements", []):
        add("- %s, %s, target=%s, size=%s, alt=%s" % (
            img.get("where"), img.get("placement"), img.get("target"),
            img.get("display_size_in"), json.dumps(img.get("alt_text"))))
    add("")

    # ---- body outline ------------------------------------------------------
    add("## 7. Body outline, in document order")
    add("")
    add("This is the structural spine. Every heading here is a candidate for the "
        "required-sections list, and the style each one uses is the mapping "
        "target for the config.")
    add("")
    for i, block in enumerate(data.get("body", [])):
        kind = block.get("kind")
        if kind == "paragraph":
            marker = "#" if block.get("is_heading") else "-"
            extras = []
            if block.get("direct_paragraph_formatting"):
                extras.append("pPr:" + ",".join(block["direct_paragraph_formatting"]))
            if block.get("direct_run_formatting"):
                extras.append("rPr:" + ",".join(sorted(block["direct_run_formatting"])))
            if block.get("fields"):
                extras.append("fields:" + "; ".join(block["fields"]))
            if block.get("images"):
                extras.append("IMAGE")
            if block.get("contains_page_break"):
                extras.append("PAGEBREAK")
            if block.get("ends_section"):
                extras.append("SECTIONBREAK")
            add("%4d %s `%s` %s%s" % (
                i, marker, block.get("style_id"),
                json.dumps((block.get("text") or "")[:160]),
                ("   [" + " | ".join(extras) + "]") if extras else ""))
        elif kind == "table":
            add("%4d T table %sx%s style=%s, grid=%s" % (
                i, block.get("row_count"), block.get("col_count"),
                (block.get("props") or {}).get("style"), block.get("grid_widths_in")))
        elif kind == "content_control":
            add("%4d C content control type=%s tag=%s alias=%s" % (
                i, block.get("control_type"), block.get("tag"), block.get("alias")))
        elif kind == "section_break":
            add("%4d = section break" % i)
    add("")

    # ---- content controls, fields, bookmarks -------------------------------
    add("## 8. Fill-in machinery")
    add("")
    ccs = [b for b in data.get("body", []) if b.get("kind") == "content_control"]
    add("- Content controls: %d" % len(ccs))
    for c in ccs:
        add("  - type=%s tag=%s alias=%s placeholder=%s" % (
            c.get("control_type"), c.get("tag"), c.get("alias"), c.get("placeholder")))
    all_fields = [f for b in data.get("body", []) for f in (b.get("fields") or [])]
    add("- Field codes in body: %d" % len(all_fields))
    for f in sorted(set(all_fields)):
        add("  - `%s`" % f)
    bookmarks = sorted({bm for b in data.get("body", []) for bm in (b.get("bookmarks") or [])})
    add("- Bookmarks: %s" % (", ".join(bookmarks) if bookmarks else "none"))
    add("")

    # ---- doc props ---------------------------------------------------------
    add("## 9. Document properties and settings")
    add("")
    add("```json")
    add(json.dumps({"doc_props": data.get("doc_props"),
                    "settings": data.get("settings")}, indent=2))
    add("```")
    add("")

    add("## 10. Parts in the package")
    add("")
    for p in data.get("parts", []):
        add("- `%s` (%d bytes)" % (p["name"], p["size"]))
    add("")

    return "\n".join(L)


