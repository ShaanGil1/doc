# document body
# --------------------------------------------------------------------------- #
def read_drawing(drawing, rels, where):
    """One w:drawing. Covers both inline and floating."""
    inline = find(drawing, "wp:inline")
    anchor = find(drawing, "wp:anchor")
    holder = inline if inline is not None else anchor
    if holder is None:
        return None
    extent = find(holder, "wp:extent")
    docpr = find(holder, "wp:docPr")
    blip = None
    for b in holder.iter(q("a:blip")):
        blip = b
        break
    rid = blip.get(q("r:embed")) if blip is not None else None
    out = {
        "where": where,
        "placement": "inline" if inline is not None else "floating",
        "name": attr(docpr, "w:name") if docpr is None else docpr.get("name"),
        "alt_text": docpr.get("descr") if docpr is not None else None,
        "title": docpr.get("title") if docpr is not None else None,
        "rId": rid,
        "target": rels.get(rid, {}).get("target") if rid else None,
    }
    if extent is not None:
        out["display_size_in"] = {
            "width": emu_to_in(extent.get("cx")),
            "height": emu_to_in(extent.get("cy")),
        }
    if anchor is not None:
        pos = {}
        for tag, axis in (("wp:positionH", "h"), ("wp:positionV", "v")):
            p = find(anchor, tag)
            if p is not None:
                pos[axis] = prune({
                    "relativeFrom": p.get("relativeFrom"),
                    "align": val_of(p, "wp:align") if find(p, "wp:align") is not None else (find(p, "wp:align").text if find(p, "wp:align") is not None else None),
                    "offset_in": emu_to_in(find(p, "wp:posOffset").text) if find(p, "wp:posOffset") is not None else None,
                })
        out["position"] = pos or None
        out["behind_text"] = anchor.get("behindDoc") in ("1", "true")
        wrap = next((local(c.tag) for c in anchor if local(c.tag).startswith("wrap")), None)
        out["wrap"] = wrap
    return prune(out)


def read_vml_images(el, rels, where):
    """Older letterheads use VML rather than DrawingML. Catch those too."""
    out = []
    for data in el.iter(q("v:imagedata")):
        rid = data.get(q("r:id"))
        out.append(prune({
            "where": where,
            "placement": "vml",
            "rId": rid,
            "target": rels.get(rid, {}).get("target") if rid else None,
            "alt_text": data.get(q("v:title")) or data.get("title"),
        }))
    return out


DIRECT_PPR_IGNORE = {"pStyle", "rPr", "sectPr"}


def direct_overrides(el, tag):
    """Which formatting children a paragraph/run sets by hand, on top of its style."""
    props = find(el, tag)
    if props is None:
        return []
    return sorted({local(c.tag) for c in props} - DIRECT_PPR_IGNORE)


def read_fields(el, red):
    """Field codes: PAGE, NUMPAGES, TOC, REF, DOCPROPERTY, STYLEREF ..."""
    codes = []
    buf = []
    for node in el.iter():
        t = local(node.tag)
        if t == "instrText" and node.text:
            buf.append(node.text)
        elif t == "fldChar" and node.get(q("w:fldCharType")) == "end" and buf:
            codes.append(red.chrome(" ".join(buf).strip()))
            buf = []
        elif t == "fldSimple":
            codes.append(red.chrome((node.get(q("w:instr")) or "").strip()))
    if buf:
        codes.append(red.chrome(" ".join(buf).strip()))
    return [c for c in codes if c]


def read_paragraph(p, styles_by_id, rels, red, where="body"):
    ppr = find(p, "w:pPr")
    style_id = val_of(ppr, "w:pStyle") or "Normal"
    style = styles_by_id.get(style_id, {})
    style_name = style.get("name", style_id)
    outline = (style.get("paragraph") or {}).get("outlineLvl")
    is_heading = (
        outline is not None
        or bool(re.match(r"(?i)^heading\s*\d", str(style_name)))
        or (read_ppr(ppr).get("outlineLvl") is not None)
    )
    text = element_text(p)
    entry = {
        "style_id": style_id,
        "style_name": style_name,
        "outline_level": outline,
        "is_heading": is_heading or None,
        "text": red.chrome(text) if where != "body" else red.body(text, is_heading),
        "text_length": len(text),
        "direct_paragraph_formatting": direct_overrides(p, "w:pPr") or None,
    }
    pdir = read_ppr(ppr)
    pdir.pop("style", None)
    pdir.pop("run_props", None)
    if pdir:
        entry["direct_paragraph_values"] = pdir
    run_overrides = Counter()
    run_styles = set()
    for run in findall(p, "w:r"):
        for name in direct_overrides(run, "w:rPr"):
            run_overrides[name] += 1
        rs = val_of(find(run, "w:rPr"), "w:rStyle")
        if rs:
            run_styles.add(rs)
    if run_overrides:
        entry["direct_run_formatting"] = dict(run_overrides)
    if run_styles:
        entry["character_styles"] = sorted(run_styles)
    fields = read_fields(p, red)
    if fields:
        entry["fields"] = fields
    hyperlinks = [rels.get(h.get(q("r:id")), {}).get("target")
                  for h in findall(p, "w:hyperlink") if h.get(q("r:id"))]
    if hyperlinks:
        entry["hyperlinks"] = [red.chrome(h) for h in hyperlinks if h]
    images = []
    for d in p.iter(q("w:drawing")):
        got = read_drawing(d, rels, where)
        if got:
            images.append(got)
    images.extend(read_vml_images(p, rels, where))
    if images:
        entry["images"] = images
    bookmarks = [b.get(q("w:name")) for b in findall(p, "w:bookmarkStart")]
    bookmarks = [b for b in bookmarks if b and not b.startswith("_GoBack")]
    if bookmarks:
        entry["bookmarks"] = bookmarks
    if find(ppr, "w:sectPr") is not None:
        entry["ends_section"] = True
    if any(local(b.tag) == "br" and b.get(q("w:type")) == "page" for b in p.iter()):
        entry["contains_page_break"] = True
    return prune(entry)


def read_table(tbl, styles_by_id, rels, red, where="body"):
    grid = [twips_to_in(gc.get(q("w:w"))) for gc in findall(tbl, "w:tblGrid/w:gridCol")]
    rows = []
    for tr in findall(tbl, "w:tr"):
        cells = []
        for tc in findall(tr, "w:tc"):
            cell_text = element_text(tc)
            cells.append(prune({
                "text": red.chrome(cell_text) if where != "body" else red.body(cell_text),
                "props": read_tcpr(find(tc, "w:tcPr")),
                "paragraph_styles": sorted({
                    val_of(find(p, "w:pPr"), "w:pStyle") or "Normal"
                    for p in findall(tc, "w:p")}),
            }))
        rows.append(prune({
            "is_repeating_header": find(tr, "w:trPr/w:tblHeader") is not None,
            "cant_split": find(tr, "w:trPr/w:cantSplit") is not None,
            "height_in": twips_to_in(val_of(find(tr, "w:trPr"), "w:trHeight")),
            "cells": cells,
        }))
    return prune({
        "kind": "table",
        "props": read_tblpr(find(tbl, "w:tblPr")),
        "grid_widths_in": grid,
        "row_count": len(rows),
        "col_count": len(grid) or (len(rows[0]["cells"]) if rows else 0),
        "rows": rows,
    })


def read_sdt(sdt, red):
    """Content control. Gov templates lean on these for fill-in fields."""
    pr = find(sdt, "w:sdtPr")
    kind = None
    if pr is not None:
        for c in pr:
            name = local(c.tag)
            if name in ("text", "richText", "dropDownList", "comboBox", "date",
                        "picture", "docPartObj", "docPartList", "checkbox", "citation"):
                kind = name
                break
    return prune({
        "kind": "content_control",
        "control_type": kind,
        "tag": val_of(pr, "w:tag"),
        "alias": val_of(pr, "w:alias"),
        "id": num(val_of(pr, "w:id")),
        "placeholder": val_of(pr, "w:placeholder/w:docPart"),
        "text": red.chrome(element_text(find(sdt, "w:sdtContent"))),
    })


def walk_block_level(container, styles_by_id, rels, red, where="body", depth=0):
    out = []
    for child in container:
        tag = local(child.tag)
        if tag == "p":
            entry = read_paragraph(child, styles_by_id, rels, red, where)
            entry["kind"] = "paragraph"
            out.append(entry)
        elif tag == "tbl":
            out.append(read_table(child, styles_by_id, rels, red, where))
        elif tag == "sdt":
            out.append(read_sdt(child, red))
            content = find(child, "w:sdtContent")
            if content is not None and depth < 4:
                out.extend(walk_block_level(content, styles_by_id, rels, red, where, depth + 1))
        elif tag == "sectPr":
            out.append({"kind": "section_break", "sectPr": read_sectpr(child, rels)})
    return out


