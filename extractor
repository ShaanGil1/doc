def read_rels(zf, part_name):
    """word/document.xml -> word/_rels/document.xml.rels"""
    folder, _, base = part_name.rpartition("/")
    rels_path = "%s/_rels/%s.rels" % (folder, base) if folder else "_rels/%s.rels" % base
    if rels_path not in zf.namelist():
        return {}
    root = ET.fromstring(zf.read(rels_path))
    out = {}
    for rel in root:
        out[rel.get("Id")] = {
            "target": rel.get("Target"),
            "type": (rel.get("Type") or "").rsplit("/", 1)[-1],
            "mode": rel.get("TargetMode"),
        }
    return out


def read_theme(zf):
    path = "word/theme/theme1.xml"
    if path not in zf.namelist():
        return None
    root = ET.fromstring(zf.read(path))
    scheme = root.find(".//a:themeElements", NS)
    if scheme is None:
        return None
    fonts = find(scheme, "a:fontScheme")
    colors = find(scheme, "a:clrScheme")
    out = {}
    if fonts is not None:
        out["fonts"] = {}
        for which in ("major", "minor"):
            f = find(fonts, "a:%sFont" % which)
            if f is not None:
                out["fonts"][which] = {
                    "latin": attr_plain(find(f, "a:latin"), "typeface"),
                    "ea": attr_plain(find(f, "a:ea"), "typeface"),
                    "cs": attr_plain(find(f, "a:cs"), "typeface"),
                }
    if colors is not None:
        out["colors"] = {}
        for c in colors:
            name = local(c.tag)
            srgb = find(c, "a:srgbClr")
            sysc = find(c, "a:sysClr")
            if srgb is not None:
                out["colors"][name] = srgb.get("val")
            elif sysc is not None:
                out["colors"][name] = sysc.get("lastClr") or sysc.get("val")
    return prune(out)


def attr_plain(el, name):
    return None if el is None else el.get(name)


def read_settings(zf):
    path = "word/settings.xml"
    if path not in zf.namelist():
        return None
    root = ET.fromstring(zf.read(path))
    compat = find(root, "w:compat")
    return prune({
        "defaultTabStop_in": twips_to_in(val_of(root, "w:defaultTabStop")),
        "evenAndOddHeaders": find(root, "w:evenAndOddHeaders") is not None,
        "mirrorMargins": find(root, "w:mirrorMargins") is not None,
        "trackChanges": find(root, "w:trackChanges") is not None,
        "documentProtection": prune({
            "edit": val_of(root, "w:documentProtection", "w:edit"),
            "enforcement": val_of(root, "w:documentProtection", "w:enforcement"),
            "formatting": val_of(root, "w:documentProtection", "w:formatting"),
        }) if find(root, "w:documentProtection") is not None else None,
        "attachedTemplate": (rels_target(zf, "word/settings.xml",
                                         val_of(root, "w:attachedTemplate", "r:id"))
                             if find(root, "w:attachedTemplate") is not None else None),
        "styleLockTheme": find(root, "w:styleLockTheme") is not None,
        "styleLockQFSet": find(root, "w:styleLockQFSet") is not None,
        "compat_setting_count": len(findall(compat, "w:compatSetting")) if compat is not None else 0,
        "rsid_count": len(findall(root, "w:rsids/w:rsid")),
    })


def rels_target(zf, part, rid):
    if not rid:
        return None
    return read_rels(zf, part).get(rid, {}).get("target")


def read_doc_props(zf, red):
    out = {}
    core = "docProps/core.xml"
    if core in zf.namelist():
        root = ET.fromstring(zf.read(core))
        pairs = {}
        for c in root:
            name = local(c.tag)
            if c.text:
                pairs[name] = red.chrome(c.text)
        out["core"] = pairs
    app = "docProps/app.xml"
    if app in zf.namelist():
        root = ET.fromstring(zf.read(app))
        pairs = {}
        for c in root:
            name = local(c.tag)
            if c.text and name in ("Template", "Application", "AppVersion", "Company",
                                   "Pages", "Words", "Paragraphs", "TotalTime"):
                pairs[name] = c.text
        out["app"] = pairs
    custom = "docProps/custom.xml"
    if custom in zf.namelist():
        root = ET.fromstring(zf.read(custom))
        props = []
        for p in root:
            value = next((c.text for c in p if c.text is not None), None)
            props.append(prune({"name": p.get("name"),
                                "value": red.chrome(value) if value else None}))
        out["custom"] = props
    return prune(out)


def read_header_footer_parts(zf, red, styles_by_id):
    parts = []
    for name in sorted(zf.namelist()):
        base = name.rsplit("/", 1)[-1]
        if not (base.startswith("header") or base.startswith("footer")) or not name.endswith(".xml"):
            continue
        root = ET.fromstring(zf.read(name))
        rels = read_rels(zf, name)
        blocks = walk_block_level(root, styles_by_id, rels, red, where=base)
        parts.append({
            "part": name,
            "kind": "header" if base.startswith("header") else "footer",
            "blocks": blocks,
        })
    return parts


def extract_media(zf, outdir, enabled):
    media = []
    for name in sorted(zf.namelist()):
        if not name.startswith("word/media/"):
            continue
        info = zf.getinfo(name)
        entry = {"part": name, "bytes": info.file_size}
        if enabled:
            target = outdir / "media" / name.rsplit("/", 1)[-1]
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(zf.read(name))
            entry["saved_to"] = str(target.relative_to(outdir))
        media.append(entry)
    return media


def dump_raw_xml(zf, outdir):
    wanted = []
    for name in zf.namelist():
        base = name.rsplit("/", 1)[-1]
        if name in ("word/styles.xml", "word/numbering.xml", "word/settings.xml",
                    "word/theme/theme1.xml", "docProps/core.xml", "docProps/custom.xml"):
            wanted.append(name)
        elif re.match(r"^header\d*\.xml$|^footer\d*\.xml$", base):
            wanted.append(name)
    saved = []
    for name in wanted:
        try:
            root = ET.fromstring(zf.read(name))
            indent(root)
            text = ET.tostring(root, encoding="unicode")
        except ET.ParseError:
            text = zf.read(name).decode("utf-8", "replace")
        target = outdir / "xml" / name.replace("/", "__")
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(text, encoding="utf-8")
        saved.append(str(target.relative_to(outdir)))
    return saved


def indent(el, level=0):
    """ET.indent is 3.9+, so roll it by hand for 3.8 compatibility."""
    pad = "\n" + "  " * level
    if len(el):
        if not (el.text or "").strip():
            el.text = pad + "  "
        for child in el:
            indent(child, level + 1)
            if not (child.tail or "").strip():
                child.tail = pad + "  "
        if not (el[-1].tail or "").strip():
            el[-1].tail = pad
    elif level and not (el.tail or "").strip():
        el.tail = pad


