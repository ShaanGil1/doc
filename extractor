NS = {
    "w": "http://schemas.openxmlformats.org/wordprocessingml/2006/main",
    "r": "http://schemas.openxmlformats.org/officeDocument/2006/relationships",
    "a": "http://schemas.openxmlformats.org/drawingml/2006/main",
    "wp": "http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing",
    "pic": "http://schemas.openxmlformats.org/drawingml/2006/picture",
    "v": "urn:schemas-microsoft-com:vml",
    "mc": "http://schemas.openxmlformats.org/markup-compatibility/2006",
    "cp": "http://schemas.openxmlformats.org/package/2006/metadata/core-properties",
    "dc": "http://purl.org/dc/elements/1.1/",
    "dcterms": "http://purl.org/dc/terms/",
    "ep": "http://schemas.openxmlformats.org/officeDocument/2006/extended-properties",
    "vt": "http://schemas.openxmlformats.org/officeDocument/2006/docPropsVTypes",
    "pr": "http://schemas.openxmlformats.org/package/2006/relationships",
    "w14": "http://schemas.microsoft.com/office/word/2010/wordml",
}

for _prefix, _uri in NS.items():
    ET.register_namespace(_prefix, _uri)

TWIPS_PER_INCH = 1440.0
EMU_PER_INCH = 914400.0


# --------------------------------------------------------------------------- #
# tiny xml helpers
# --------------------------------------------------------------------------- #
def q(name):
    """'w:val' -> '{namespace}val'"""
    prefix, _, local = name.partition(":")
    return "{%s}%s" % (NS[prefix], local)


def find(parent, path):
    return None if parent is None else parent.find(path, NS)


def findall(parent, path):
    return [] if parent is None else parent.findall(path, NS)


def attr(el, name="w:val", default=None):
    if el is None:
        return default
    v = el.get(q(name))
    return default if v is None else v


def val_of(parent, path, name="w:val", default=None):
    return attr(find(parent, path), name, default)


def toggle(parent, path):
    """Word toggle: present = on, w:val='0'/'false'/'off' = off, absent = None."""
    el = find(parent, path)
    if el is None:
        return None
    v = el.get(q("w:val"))
    if v is None:
        return True
    return v not in ("0", "false", "off")


def num(v):
    try:
        return int(v)
    except (TypeError, ValueError):
        try:
            return float(v)
        except (TypeError, ValueError):
            return None


def twips_to_in(v):
    n = num(v)
    return None if n is None else round(n / TWIPS_PER_INCH, 4)


def twips_to_pt(v):
    n = num(v)
    return None if n is None else round(n / 20.0, 2)


def halfpt_to_pt(v):
    n = num(v)
    return None if n is None else round(n / 2.0, 2)


def eighthpt_to_pt(v):
    n = num(v)
    return None if n is None else round(n / 8.0, 3)


def emu_to_in(v):
    n = num(v)
    return None if n is None else round(n / EMU_PER_INCH, 3)


def prune(d):
    """Drop None / empty values so the JSON shows only what the file actually sets."""
    if isinstance(d, dict):
        out = {}
        for k, v in d.items():
            v = prune(v)
            if v is not None and v != {} and v != []:
                out[k] = v
        return out
    if isinstance(d, list):
        return [prune(x) for x in d]
    return d


def local(tag):
    return tag.split("}")[-1]


# --------------------------------------------------------------------------- #
# text
# --------------------------------------------------------------------------- #
def element_text(el, keep_breaks=True):
    """Visible text of a paragraph/cell, tabs and breaks preserved."""
    if el is None:
        return ""
    out = []
    for node in el.iter():
        t = local(node.tag)
        if t == "t" and node.text:
            out.append(node.text)
        elif t == "tab":
            out.append("\t")
        elif t in ("br", "cr") and keep_breaks:
            out.append("\n")
        elif t == "noBreakHyphen":
            out.append("-")
        elif t == "sym":
            out.append("[sym:%s]" % attr(node, "w:char", "?"))
    return "".join(out)


class Redactor:
    def __init__(self, mode):
        self.mode = mode  # "none" | "body" | "all"

    def body(self, text, is_heading=False):
        if self.mode == "none":
            return text
        if self.mode == "body" and is_heading:
            return text
        return self.mask(text)

    def chrome(self, text):
        """Headers, footers, styles, field codes. Only --redact-all hides these."""
        return self.mask(text) if self.mode == "all" else text

    @staticmethod
    def mask(text):
        text = text or ""
        return "" if not text.strip() else "<len=%d>" % len(text)


# --------------------------------------------------------------------------- #
# property readers, shared between styles / numbering / body paragraphs
# --------------------------------------------------------------------------- #
def read_ind(ind):
    if ind is None:
        return None
    out = {}
    for name in ("left", "start", "right", "end", "firstLine", "hanging"):
        v = ind.get(q("w:" + name))
        if v is not None:
            out[name + "_in"] = twips_to_in(v)
    for name in ("leftChars", "rightChars", "firstLineChars", "hangingChars"):
        v = ind.get(q("w:" + name))
        if v is not None:
            out[name] = num(v)
    return out or None


def read_spacing(sp):
    if sp is None:
        return None
    out = {
        "before_pt": twips_to_pt(sp.get(q("w:before"))),
        "after_pt": twips_to_pt(sp.get(q("w:after"))),
        "line": num(sp.get(q("w:line"))),
        "lineRule": sp.get(q("w:lineRule")),
        "beforeAutospacing": sp.get(q("w:beforeAutospacing")),
        "afterAutospacing": sp.get(q("w:afterAutospacing")),
    }
    if out.get("line") is not None and out.get("lineRule") == "auto":
        out["line_multiple"] = round(out["line"] / 240.0, 3)
    return prune(out) or None


def read_borders(bdr):
    if bdr is None:
        return None
    out = {}
    for side in bdr:
        name = local(side.tag)
        out[name] = prune({
            "val": side.get(q("w:val")),
            "size_pt": eighthpt_to_pt(side.get(q("w:sz"))),
            "space_pt": num(side.get(q("w:space"))),
            "color": side.get(q("w:color")),
            "themeColor": side.get(q("w:themeColor")),
            "shadow": side.get(q("w:shadow")),
        })
    return out or None


def read_shd(shd):
    if shd is None:
        return None
    return prune({
        "val": shd.get(q("w:val")),
        "fill": shd.get(q("w:fill")),
        "color": shd.get(q("w:color")),
        "themeFill": shd.get(q("w:themeFill")),
    }) or None


def read_tabs(tabs):
    if tabs is None:
        return None
    out = []
    for tab in findall(tabs, "w:tab"):
        out.append(prune({
            "val": tab.get(q("w:val")),
            "pos_in": twips_to_in(tab.get(q("w:pos"))),
            "leader": tab.get(q("w:leader")),
        }))
    return out or None


def read_ppr(ppr):
    """Paragraph properties. Same shape whether it came from a style or a paragraph."""
    if ppr is None:
        return {}
    numpr = find(ppr, "w:numPr")
    out = {
        "style": val_of(ppr, "w:pStyle"),
        "align": val_of(ppr, "w:jc"),
        "outlineLvl": num(val_of(ppr, "w:outlineLvl")),
        "keepNext": toggle(ppr, "w:keepNext"),
        "keepLines": toggle(ppr, "w:keepLines"),
        "pageBreakBefore": toggle(ppr, "w:pageBreakBefore"),
        "widowControl": toggle(ppr, "w:widowControl"),
        "contextualSpacing": toggle(ppr, "w:contextualSpacing"),
        "suppressLineNumbers": toggle(ppr, "w:suppressLineNumbers"),
        "indent": read_ind(find(ppr, "w:ind")),
        "spacing": read_spacing(find(ppr, "w:spacing")),
        "borders": read_borders(find(ppr, "w:pBdr")),
        "shading": read_shd(find(ppr, "w:shd")),
        "tabs": read_tabs(find(ppr, "w:tabs")),
        "textAlignment": val_of(ppr, "w:textAlignment"),
        "has_sectPr": find(ppr, "w:sectPr") is not None,
    }
    if numpr is not None:
        out["numPr"] = prune({
            "numId": num(val_of(numpr, "w:numId")),
            "ilvl": num(val_of(numpr, "w:ilvl")),
        })
    out["run_props"] = read_rpr(find(ppr, "w:rPr")) or None
    return prune(out)


def read_rpr(rpr):
    """Run properties."""
    if rpr is None:
        return {}
    fonts = find(rpr, "w:rFonts")
    color = find(rpr, "w:color")
    u = find(rpr, "w:u")
    out = {
        "charStyle": val_of(rpr, "w:rStyle"),
        "size_pt": halfpt_to_pt(val_of(rpr, "w:sz")),
        "sizeComplex_pt": halfpt_to_pt(val_of(rpr, "w:szCs")),
        "bold": toggle(rpr, "w:b"),
        "italic": toggle(rpr, "w:i"),
        "caps": toggle(rpr, "w:caps"),
        "smallCaps": toggle(rpr, "w:smallCaps"),
        "strike": toggle(rpr, "w:strike"),
        "vanish": toggle(rpr, "w:vanish"),
        "noProof": toggle(rpr, "w:noProof"),
        "vertAlign": val_of(rpr, "w:vertAlign"),
        "highlight": val_of(rpr, "w:highlight"),
        "spacing_pt": twips_to_pt(val_of(rpr, "w:spacing")),
        "position_halfpt": num(val_of(rpr, "w:position")),
        "lang": attr(find(rpr, "w:lang"), "w:val"),
        "shading": read_shd(find(rpr, "w:shd")),
        "borders": read_borders(find(rpr, "w:bdr")) if find(rpr, "w:bdr") is not None else None,
    }
    if u is not None:
        out["underline"] = prune({"val": u.get(q("w:val")), "color": u.get(q("w:color"))})
    if color is not None:
        out["color"] = prune({
            "rgb": color.get(q("w:val")),
            "themeColor": color.get(q("w:themeColor")),
        })
    if fonts is not None:
        out["fonts"] = prune({k: fonts.get(q("w:" + k)) for k in (
            "ascii", "hAnsi", "cs", "eastAsia",
            "asciiTheme", "hAnsiTheme", "cstheme", "eastAsiaTheme", "hint")})
    return prune(out)


def read_tblpr(tblpr):
    if tblpr is None:
        return {}
    look = find(tblpr, "w:tblLook")
    width = find(tblpr, "w:tblW")
    ind = find(tblpr, "w:tblInd")
    out = {
        "style": val_of(tblpr, "w:tblStyle"),
        "align": val_of(tblpr, "w:jc"),
        "layout": val_of(tblpr, "w:tblLayout", "w:type"),
        "borders": read_borders(find(tblpr, "w:tblBorders")),
        "shading": read_shd(find(tblpr, "w:shd")),
    }
    if width is not None:
        out["width"] = {"w": num(width.get(q("w:w"))), "type": width.get(q("w:type"))}
    if ind is not None:
        out["indent_in"] = twips_to_in(ind.get(q("w:w")))
    if look is not None:
        out["look"] = prune({k: look.get(q("w:" + k)) for k in (
            "val", "firstRow", "lastRow", "firstColumn", "lastColumn",
            "noHBand", "noVBand")})
    margins = find(tblpr, "w:tblCellMar")
    if margins is not None:
        out["cell_margins_in"] = prune({
            local(side.tag): twips_to_in(side.get(q("w:w"))) for side in margins})
    return prune(out)


def read_tcpr(tcpr):
    if tcpr is None:
        return {}
    width = find(tcpr, "w:tcW")
    out = {
        "borders": read_borders(find(tcpr, "w:tcBorders")),
        "shading": read_shd(find(tcpr, "w:shd")),
        "vAlign": val_of(tcpr, "w:vAlign"),
        "gridSpan": num(val_of(tcpr, "w:gridSpan")),
        "vMerge": attr(find(tcpr, "w:vMerge"), "w:val", "continue") if find(tcpr, "w:vMerge") is not None else None,
        "noWrap": toggle(tcpr, "w:noWrap"),
    }
    if width is not None:
        out["width"] = {"w": num(width.get(q("w:w"))), "type": width.get(q("w:type"))}
    return prune(out)


# --------------------------------------------------------------------------- #
# styles.xml
# --------------------------------------------------------------------------- #
def read_styles(root, red):
    if root is None:
        return {}

    defaults = {}
    dd = find(root, "w:docDefaults")
    if dd is not None:
        defaults = prune({
            "paragraph": read_ppr(find(dd, "w:pPrDefault/w:pPr")),
            "run": read_rpr(find(dd, "w:rPrDefault/w:rPr")),
        })

    styles = []
    for st in findall(root, "w:style"):
        entry = {
            "id": st.get(q("w:styleId")),
            "name": val_of(st, "w:name"),
            "type": st.get(q("w:type")),
            "is_default": st.get(q("w:default")) in ("1", "true"),
            "custom": st.get(q("w:customStyle")) in ("1", "true"),
            "basedOn": val_of(st, "w:basedOn"),
            "next": val_of(st, "w:next"),
            "link": val_of(st, "w:link"),
            "uiPriority": num(val_of(st, "w:uiPriority")),
            "quickFormat": find(st, "w:qFormat") is not None,
            "semiHidden": find(st, "w:semiHidden") is not None,
            "unhideWhenUsed": find(st, "w:unhideWhenUsed") is not None,
            "autoRedefine": find(st, "w:autoRedefine") is not None,
            "paragraph": read_ppr(find(st, "w:pPr")),
            "run": read_rpr(find(st, "w:rPr")),
            "table": read_tblpr(find(st, "w:tblPr")),
            "cell": read_tcpr(find(st, "w:tcPr")),
        }
        conditional = []
        for cond in findall(st, "w:tblStylePr"):
            conditional.append(prune({
                "type": cond.get(q("w:type")),
                "paragraph": read_ppr(find(cond, "w:pPr")),
                "run": read_rpr(find(cond, "w:rPr")),
                "table": read_tblpr(find(cond, "w:tblPr")),
                "cell": read_tcpr(find(cond, "w:tcPr")),
            }))
        if conditional:
            entry["conditional_formatting"] = conditional
        styles.append(prune(entry))

    latent = find(root, "w:latentStyles")
    latent_summary = None
    if latent is not None:
        latent_summary = prune({
            "count": num(latent.get(q("w:count"))),
            "defQFormat": latent.get(q("w:defQFormat")),
            "defUIPriority": num(latent.get(q("w:defUIPriority"))),
            "exceptions": len(findall(latent, "w:lsdException")),
        })

    return prune({
        "doc_defaults": defaults,
        "styles": styles,
        "latent_styles": latent_summary,
    })


def resolve_style(styles_by_id, style_id, seen=None):
    """Best effort merge down the basedOn chain. Word also layers docDefaults,
    numbering-level pPr, table conditional formatting and direct formatting on
    top, so treat this as a reading aid, not gospel."""
    seen = seen or set()
    st = styles_by_id.get(style_id)
    if st is None or style_id in seen:
        return {}
    seen.add(style_id)
    base = resolve_style(styles_by_id, st.get("basedOn"), seen) if st.get("basedOn") else {}
    merged = {"paragraph": dict(base.get("paragraph") or {}),
              "run": dict(base.get("run") or {})}
    for bucket in ("paragraph", "run"):
        for k, v in (st.get(bucket) or {}).items():
            if isinstance(v, dict) and isinstance(merged[bucket].get(k), dict):
                child = dict(merged[bucket][k])
                child.update(v)
                merged[bucket][k] = child
            else:
                merged[bucket][k] = v
    return merged


# --------------------------------------------------------------------------- #
# numbering.xml
# --------------------------------------------------------------------------- #
FMT_SAMPLE = {
    "decimal": "1", "lowerLetter": "a", "upperLetter": "A",
    "lowerRoman": "i", "upperRoman": "I", "bullet": "*",
    "decimalZero": "01", "ordinal": "1st", "cardinalText": "one",
    "ordinalText": "first", "none": "",
}


def read_level(lvl):
    ppr = find(lvl, "w:pPr")
    rpr = find(lvl, "w:rPr")
    fonts = find(rpr, "w:rFonts") if rpr is not None else None
    return prune({
        "ilvl": num(lvl.get(q("w:ilvl"))),
        "start": num(val_of(lvl, "w:start")),
        "numFmt": val_of(lvl, "w:numFmt"),
        "lvlText": val_of(lvl, "w:lvlText"),
        "lvlJc": val_of(lvl, "w:lvlJc"),
        "suffix": val_of(lvl, "w:suff"),
        "isLgl": find(lvl, "w:isLgl") is not None,
        "restart_after_lvl": num(val_of(lvl, "w:lvlRestart")),
        "linked_pStyle": val_of(lvl, "w:pStyle"),
        "indent": read_ind(find(ppr, "w:ind")) if ppr is not None else None,
        "marker_font": (fonts.get(q("w:ascii")) if fonts is not None else None),
        "marker_run": read_rpr(rpr) or None,
    })


def render_marker(level):
    """Turn '%1.%2.' plus formats into something readable like '1.a.'"""
    text = level.get("lvlText") or ""
    if level.get("numFmt") == "bullet":
        return "bullet(%s)" % (level.get("marker_font") or "?")

    def sub(match):
        return FMT_SAMPLE.get(level.get("numFmt"), "?")

    return re.sub(r"%\d", sub, text) or "?"


def read_numbering(root):
    if root is None:
        return {}
    abstracts = []
    for ab in findall(root, "w:abstractNum"):
        levels = [read_level(lvl) for lvl in findall(ab, "w:lvl")]
        cascade = " -> ".join(
            "%s" % (lv.get("lvlText") if lv.get("numFmt") != "bullet"
                    else "bullet")
            for lv in levels[:5])
        formats = " -> ".join((lv.get("numFmt") or "?") for lv in levels[:5])
        abstracts.append(prune({
            "abstractNumId": num(ab.get(q("w:abstractNumId"))),
            "name": val_of(ab, "w:name"),
            "multiLevelType": val_of(ab, "w:multiLevelType"),
            "styleLink": val_of(ab, "w:styleLink"),
            "numStyleLink": val_of(ab, "w:numStyleLink"),
            "level_count": len(levels),
            "cascade_lvlText": cascade,
            "cascade_formats": formats,
            "linked_styles": [lv["linked_pStyle"] for lv in levels if lv.get("linked_pStyle")],
            "levels": levels,
        }))

    nums = []
    for n in findall(root, "w:num"):
        overrides = []
        for ov in findall(n, "w:lvlOverride"):
            overrides.append(prune({
                "ilvl": num(ov.get(q("w:ilvl"))),
                "startOverride": num(val_of(ov, "w:startOverride")),
                "level": read_level(find(ov, "w:lvl")) if find(ov, "w:lvl") is not None else None,
            }))
        nums.append(prune({
            "numId": num(n.get(q("w:numId"))),
            "abstractNumId": num(val_of(n, "w:abstractNumId")),
            "overrides": overrides,
        }))

    return {"abstract_definitions": abstracts, "instances": nums}


# --------------------------------------------------------------------------- #
# sectPr
# --------------------------------------------------------------------------- #
def read_sectpr(sect, rels):
    if sect is None:
        return None
    pgsz = find(sect, "w:pgSz")
    pgmar = find(sect, "w:pgMar")
    cols = find(sect, "w:cols")
    pgnum = find(sect, "w:pgNumType")
    out = {"type": val_of(sect, "w:type", default="nextPage")}
    if pgsz is not None:
        out["page"] = prune({
            "width_in": twips_to_in(pgsz.get(q("w:w"))),
            "height_in": twips_to_in(pgsz.get(q("w:h"))),
            "orient": pgsz.get(q("w:orient")) or "portrait",
        })
    if pgmar is not None:
        out["margins_in"] = prune({
            k: twips_to_in(pgmar.get(q("w:" + k)))
            for k in ("top", "right", "bottom", "left", "header", "footer", "gutter")})
    if cols is not None:
        out["columns"] = prune({
            "count": num(cols.get(q("w:num"))) or 1,
            "space_in": twips_to_in(cols.get(q("w:space"))),
            "equalWidth": cols.get(q("w:equalWidth")),
            "separator": cols.get(q("w:sep")),
        })
    if pgnum is not None:
        out["page_numbering"] = prune({
            "start": num(pgnum.get(q("w:start"))),
            "format": pgnum.get(q("w:fmt")),
            "chapStyle": pgnum.get(q("w:chapStyle")),
        })
    out["different_first_page"] = find(sect, "w:titlePg") is not None
    out["vertical_align"] = val_of(sect, "w:vAlign")
    lnnum = find(sect, "w:lnNumType")
    if lnnum is not None:
        out["line_numbering"] = prune({
            "countBy": num(lnnum.get(q("w:countBy"))),
            "restart": lnnum.get(q("w:restart")),
            "start": num(lnnum.get(q("w:start"))),
        })
    refs = []
    for tag, kind in (("w:headerReference", "header"), ("w:footerReference", "footer")):
        for ref in findall(sect, tag):
            rid = ref.get(q("r:id"))
            refs.append({"kind": kind, "type": ref.get(q("w:type")),
                         "rId": rid, "part": rels.get(rid, {}).get("target")})
    if refs:
        out["header_footer_refs"] = refs
    return prune(out)


