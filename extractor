def extract(path: Path, outdir: Path, redaction: str, save_media: bool):
    with zipfile.ZipFile(path) as zf:
        names = zf.namelist()
        if "word/document.xml" not in names:
            raise SystemExit(
                "No word/document.xml in %s. If this is a .doc (not .docx), open it "
                "in Word and Save As .docx first." % path)

        red = Redactor(redaction)
        doc_rels = read_rels(zf, "word/document.xml")

        styles_root = ET.fromstring(zf.read("word/styles.xml")) if "word/styles.xml" in names else None
        styles = read_styles(styles_root, red)
        styles_by_id = {s["id"]: s for s in styles.get("styles", []) if s.get("id")}

        numbering_root = (ET.fromstring(zf.read("word/numbering.xml"))
                          if "word/numbering.xml" in names else None)

        doc_root = ET.fromstring(zf.read("word/document.xml"))
        body = find(doc_root, "w:body")
        blocks = walk_block_level(body, styles_by_id, doc_rels, red, where="body")

        sect_prs = [read_sectpr(sp, doc_rels) for sp in body.iter(q("w:sectPr"))]

        paragraphs = [b for b in blocks if b.get("kind") == "paragraph"]
        hand = [p for p in paragraphs
                if p.get("direct_paragraph_formatting") or p.get("direct_run_formatting")]
        usage = Counter(p.get("style_id") for p in paragraphs)
        for b in blocks:
            if b.get("kind") == "table":
                for row in b.get("rows", []):
                    for cell in row.get("cells", []):
                        for sid in cell.get("paragraph_styles", []):
                            usage[sid] += 1

        heading_ids = [sid for sid, s in styles_by_id.items()
                       if (s.get("paragraph") or {}).get("outlineLvl") is not None
                       or re.match(r"(?i)^heading\s*\d", str(s.get("name") or ""))]
        resolved = OrderedDict()
        for sid in sorted(heading_ids):
            resolved[sid] = resolve_style(styles_by_id, sid)

        placements = []
        for b in blocks:
            placements.extend(b.get("images") or [])
        hf = read_header_footer_parts(zf, red, styles_by_id)
        for part in hf:
            for b in part["blocks"]:
                placements.extend(b.get("images") or [])

        outdir.mkdir(parents=True, exist_ok=True)
        media = extract_media(zf, outdir, save_media)
        raw = dump_raw_xml(zf, outdir)

        data = {
            "meta": {
                "source": path.name,
                "source_bytes": path.stat().st_size,
                "redaction": redaction,
                "extractor": "template_extract.py",
            },
            "parts": [{"name": n, "size": zf.getinfo(n).file_size} for n in sorted(names)],
            "doc_props": read_doc_props(zf, red),
            "settings": read_settings(zf),
            "theme": read_theme(zf),
            "styles": styles,
            "resolved_headings": resolved,
            "style_usage": dict(usage),
            "numbering": read_numbering(numbering_root),
            "sections": [s for s in sect_prs if s],
            "headers_footers": hf,
            "media": media,
            "image_placements": placements,
            "raw_xml_saved": raw,
            "body_stats": {
                "paragraphs": len(paragraphs),
                "hand_formatted": len(hand),
                "hand_formatted_pct": round(100.0 * len(hand) / len(paragraphs), 1) if paragraphs else 0,
                "tables": sum(1 for b in blocks if b.get("kind") == "table"),
                "content_controls": sum(1 for b in blocks if b.get("kind") == "content_control"),
            },
            "body": blocks,
        }

        (outdir / "dump.json").write_text(
            json.dumps(data, indent=2, ensure_ascii=False), encoding="utf-8")
        (outdir / "report.md").write_text(
            build_report(data, path.name), encoding="utf-8")
        return data


def main(argv=None):
    ap = argparse.ArgumentParser(
        description="Dump the formatting baked into a .docx/.dotx template.")
    ap.add_argument("template", help="path to the .docx or .dotx")
    ap.add_argument("-o", "--outdir", default=None,
                    help="output directory (default: <name>_dump)")
    group = ap.add_mutually_exclusive_group()
    group.add_argument("--redact-body", action="store_true",
                       help="replace body text with <len=NN>, keep headings")
    group.add_argument("--redact-all", action="store_true",
                       help="replace all text everywhere, structure only")
    ap.add_argument("--no-media", action="store_true",
                    help="do not write image files out")
    args = ap.parse_args(argv)

    path = Path(args.template).expanduser()
    if not path.is_file():
        raise SystemExit("Not a file: %s" % path)

    outdir = Path(args.outdir) if args.outdir else path.with_suffix("").with_name(
        path.stem + "_dump")
    redaction = "all" if args.redact_all else ("body" if args.redact_body else "none")

    data = extract(path, outdir, redaction, not args.no_media)

    print("wrote %s" % (outdir / "report.md"))
    print("wrote %s" % (outdir / "dump.json"))
    if data.get("raw_xml_saved"):
        print("wrote %d raw xml parts to %s" % (len(data["raw_xml_saved"]), outdir / "xml"))
    if not args.no_media and data.get("media"):
        print("wrote %d images to %s" % (len(data["media"]), outdir / "media"))
    st = data["body_stats"]
    print("\n%d body paragraphs, %d tables, %d content controls" % (
        st["paragraphs"], st["tables"], st["content_controls"]))
    print("%s%% of paragraphs carry direct formatting on top of their style"
          % st["hand_formatted_pct"])
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
