+# Test 4: several claims in one section resolve to a SINGLE batched conflict call.
+# Only one ConflictFindings is queued; if the code called per-claim, the second
+# call would drain the empty queue and we'd lose a flag. Two flags proves one call.
+def test_one_batched_conflict_call_per_section():
+    reset_fake_llm()
+
+    section = Section(
+        order=0,
+        title="Travel",
+        content=(
+            "Employees must submit travel expense reports within 30 days of trip completion. "
+            "Travel under $500 requires supervisor approval before booking."
+        ),
+    )
+
+    register_fake_responses("ExtractedClaimsLLM", [
+        ExtractedClaimsLLM(claims=[
+            ExtractedClaimLLM(
+                claim_text="Travel expense reports must be submitted within 30 days of trip completion.",
+                original_text="Employees must submit travel expense reports within 30 days of trip completion.",
+            ),
+            ExtractedClaimLLM(
+                claim_text="Travel under 500 dollars requires supervisor approval before booking.",
+                original_text="Travel under $500 requires supervisor approval before booking.",
+            ),
+        ]),
+    ])
+
+    register_fake_responses("ConflictFindings", [
+        ConflictFindings(conflicts=[
+            ConflictFinding(
+                claim_index=1, source_index=1,
+                reason="30 day deadline vs 45 days.",
+                source_excerpt="All travel expense forms must be submitted within 45 days of the trip end date.",
+            ),
+            ConflictFinding(
+                claim_index=2, source_index=2,
+                reason="Prior approval required vs not required under 500 dollars.",
+                source_excerpt="Travel under $500 does not require prior supervisor approval.",
+            ),
+        ]),
+    ])
+
+    payload = FindConflictInput(sections=[section], selected_doc_ids=["doc_sop_travel"])
+    flags = find_conflict_flags_for_draft(payload)
+
+    assert len(flags) == 2, f"expected 2 flags from one batched call, got {len(flags)}"
+    offending = {f.offending_text for f in flags}
+    assert "Employees must submit travel expense reports within 30 days of trip completion." in offending
+    assert "Travel under $500 requires supervisor approval before booking." in offending
+    print("PASS test_one_batched_conflict_call_per_section")
+
+
