+                original_text="Employees must submit travel expense reports within 30 days of trip completion.",
+            ),
+        ]),
+    })
+    register_fake_responses_by_key("ConflictFindings", {
+        "30 days of trip completion": ConflictFindings(conflicts=[
+            ConflictFinding(claim_index=1, source_index=1, reason="30 vs 45 days.",
