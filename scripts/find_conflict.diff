+        ]),
+    })
+
+    real_search = conflict_finder.search
+    real_wait = conflict_finder.RETRY_WAIT_SECONDS
+    state = {"calls": 0}
+
+    def flaky_search(*args, **kwargs):
+        state["calls"] += 1
+        if state["calls"] == 1:
+            raise RuntimeError("transient lookup failure")
+        return real_search(*args, **kwargs)
+
+    conflict_finder.search = flaky_search
+    conflict_finder.RETRY_WAIT_SECONDS = 0  # don't actually wait in the test
+    try:
+        payload = FindConflictInput(sections=[section], selected_doc_ids=["doc_sop_travel"])
+        flags = find_conflict_flags_for_draft(payload)
+    finally:
+        conflict_finder.search = real_search
+        conflict_finder.RETRY_WAIT_SECONDS = real_wait
+
+    assert state["calls"] >= 2, "expected a retry after the first failure"
+    assert len(flags) == 1, f"expected 1 flag after retry recovery, got {len(flags)}"
+    print("PASS test_section_retry_recovers")
