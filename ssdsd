#!/usr/bin/env python3
"""
template_basics.py

Stripped-down replacement for template_extract.py, aimed at the DLA template
specifically. Answers four questions and nothing else:

    1. What styles are ACTUALLY used, and what do they look like?
    2. What are the real numbering cascades?
    3. How do the 10 sections map to the 11 header/footer parts?
    4. Is the "88.7% hand formatted" number real or is it Word noise?

    python3 template_basics.py TEMPLATE.docx
    python3 template_basics.py TEMPLATE.docx --redact

Outputs:
    basics.md          short report, meant to be read top to bottom
    worksheet.tsv      one row per body block, open in Excel and annotate

Standard library only. Reads the file, never writes to it. Python 3.8+.
"""

from __future__ import annotations

import argparse
import csv
import re
import xml.etree.ElementTree as ET
import zipfile
from collections import Counter, defaultdict
from pathlib import Path

NS = {
    "w": "http://schemas.openxmlformats.org/wordprocessingml/2006/main",
    "r": "http://schemas.openxmlformats.org/officeDocument/2006/relationships",
}

TWIPS_PER_INCH = 1440.0

# Word writes these on its own. They are not somebody formatting by hand.
NOISE_PROPS = {
    "lang", "noProof", "rPr", "widowControl", "bidi", "kern",
    "szCs", "bCs", "iCs", "rtl", "cs", "spacing_auto", "snapToGrid",
    "autoSpaceDE", "autoSpaceDN", "adjustRightInd", "eastAsianLayout",
}

# These mean a human overrode the style.
MEANINGFUL_PROPS = {
    "ind", "spacing", "jc", "numPr", "keepNext", "keepLines", "pBdr", "shd",
    "tabs", "pageBreakBefore", "contextualSpacing", "outlineLvl",
    "sz", "b", "i", "u", "color", "rFonts", "caps", "smallCaps", "strike",
    "highlight", "position", "vertAlign",
}


def q(name):
    prefix, _, local_part = name.partition(":")
    return "{%s}%s" % (NS[prefix], local_part)


def local(tag):
    return tag.split("}")[-1]


def find(parent, path):
    return None if parent is None else parent.find(path, NS)


def findall(parent, path):
    return [] if parent is None else parent.findall(path, NS)


def val_of(parent, path, name="w:val", default=None):
    el = find(parent, path)
    if el is None:
        return default
    v = el.get(q(name))
    return default if v is None else v


def num(v):
    try:
        return int(v)
    except (TypeError, ValueError):
        return None


def twips_in(v):
    n = num(v)
    return None if n is None else round(n / TWIPS_PER_INCH, 3)


def halfpt(v):
    n = num(v)
    return None if n is None else round(n / 2.0, 1)


def text_of(el):
    if el is None:
        return ""
    out = []
    for node in el.iter():
        t = local(node.tag)
        if t == "t" and node.text:
            out.append(node.text)
        elif t == "tab":
            out.append("\t")
        elif t in ("br", "cr"):
            out.append(" ")
    return "".join(out)


# --------------------------------------------------------------------------- #
# styles
# --------------------------------------------------------------------------- #
def describe_ppr(ppr):
    """Short human string for a paragraph property block."""
    if ppr is None:
        return ""
    bits = []
    jc = val_of(ppr, "w:jc")
    if jc:
        bits.append("align=" + jc)
    sp = find(ppr, "w:spacing")
    if sp is not None:
        for a, label in (("w:before", "before"), ("w:after", "after")):
            v = sp.get(q(a))
            if v is not None:
                bits.append("%s=%gpt" % (label, num(v) / 20.0))
        line = sp.get(q("w:line"))
        if line and sp.get(q("w:lineRule")) == "auto":
            bits.append("line=%gx" % (num(line) / 240.0))
    ind = find(ppr, "w:ind")
    if ind is not None:
        for a, label in (("w:left", "left"), ("w:start", "left"),
                         ("w:hanging", "hang"), ("w:firstLine", "first"),
                         ("w:right", "right")):
            v = ind.get(q(a))
            if v is not None:
                bits.append('%s=%.2f"' % (label, twips_in(v)))
    for tag, label in (("w:keepNext", "keepNext"), ("w:keepLines", "keepLines"),
                       ("w:pageBreakBefore", "pageBreak"),
                       ("w:contextualSpacing", "contextual")):
        if find(ppr, tag) is not None:
            bits.append(label)
    lvl = val_of(ppr, "w:outlineLvl")
    if lvl is not None:
        bits.append("outline=%s" % lvl)
    npr = find(ppr, "w:numPr")
    if npr is not None:
        bits.append("numId=%s ilvl=%s" % (val_of(npr, "w:numId"),
                                          val_of(npr, "w:ilvl")))
    return ", ".join(bits)


def describe_rpr(rpr):
    if rpr is None:
        return ""
    bits = []
    fonts = find(rpr, "w:rFonts")
    if fonts is not None:
        f = fonts.get(q("w:ascii")) or fonts.get(q("w:asciiTheme"))
        if f:
            bits.append(f)
    sz = val_of(rpr, "w:sz")
    if sz:
        bits.append("%gpt" % halfpt(sz))
    for tag, label in (("w:b", "bold"), ("w:i", "italic"), ("w:caps", "caps"),
                       ("w:smallCaps", "smallcaps"), ("w:strike", "strike")):
        el = find(rpr, tag)
        if el is not None and el.get(q("w:val")) not in ("0", "false", "off"):
            bits.append(label)
    if find(rpr, "w:u") is not None:
        bits.append("underline")
    color = val_of(rpr, "w:color")
    if color and color != "auto":
        bits.append("#" + color)
    rs = val_of(rpr, "w:rStyle")
    if rs:
        bits.append("char:" + rs)
    return ", ".join(bits)


def read_styles(root):
    out = {}
    if root is None:
        return out
    for st in findall(root, "w:style"):
        sid = st.get(q("w:styleId"))
        if not sid:
            continue
        out[sid] = {
            "id": sid,
            "name": val_of(st, "w:name") or sid,
            "type": st.get(q("w:type")),
            "custom": st.get(q("w:customStyle")) in ("1", "true"),
            "basedOn": val_of(st, "w:basedOn"),
            "next": val_of(st, "w:next"),
            "outline": val_of(find(st, "w:pPr"), "w:outlineLvl"),
            "ppr": describe_ppr(find(st, "w:pPr")),
            "rpr": describe_rpr(find(st, "w:rPr")),
            "numId": val_of(find(find(st, "w:pPr"), "w:numPr"), "w:numId"),
        }
    return out


def doc_defaults(root):
    dd = find(root, "w:docDefaults") if root is not None else None
    if dd is None:
        return "", ""
    return (describe_rpr(find(dd, "w:rPrDefault/w:rPr")),
            describe_ppr(find(dd, "w:pPrDefault/w:pPr")))


def inherit_chain(styles, sid, seen=None):
    seen = seen or []
    if sid not in styles or sid in seen:
        return seen
    seen = seen + [sid]
    base = styles[sid].get("basedOn")
    return inherit_chain(styles, base, seen) if base else seen


# --------------------------------------------------------------------------- #
# numbering
# --------------------------------------------------------------------------- #
FMT_SAMPLE = {
    "decimal": "1", "lowerLetter": "a", "upperLetter": "A",
    "lowerRoman": "i", "upperRoman": "I", "bullet": "*", "none": "",
    "decimalZero": "01",
}


def read_numbering(root):
    if root is None:
        return {}, {}
    abstracts = {}
    for ab in findall(root, "w:abstractNum"):
        aid = num(ab.get(q("w:abstractNumId")))
        levels = []
        for lvl in findall(ab, "w:lvl"):
            ppr = find(lvl, "w:pPr")
            ind = find(ppr, "w:ind") if ppr is not None else None
            fonts = find(find(lvl, "w:rPr"), "w:rFonts")
            levels.append({
                "ilvl": num(lvl.get(q("w:ilvl"))),
                "fmt": val_of(lvl, "w:numFmt"),
                "text": val_of(lvl, "w:lvlText"),
                "start": val_of(lvl, "w:start"),
                "style": val_of(lvl, "w:pStyle"),
                "left": twips_in(ind.get(q("w:left")) or ind.get(q("w:start"))) if ind is not None else None,
                "hang": twips_in(ind.get(q("w:hanging"))) if ind is not None else None,
                "font": fonts.get(q("w:ascii")) if fonts is not None else None,
            })
        abstracts[aid] = {
            "id": aid,
            "name": val_of(ab, "w:name"),
            "multi": val_of(ab, "w:multiLevelType"),
            "styleLink": val_of(ab, "w:styleLink"),
            "numStyleLink": val_of(ab, "w:numStyleLink"),
            "levels": levels,
        }
    nums = {}
    for n in findall(root, "w:num"):
        nid = num(n.get(q("w:numId")))
        nums[nid] = {
            "numId": nid,
            "abstract": num(val_of(n, "w:abstractNumId")),
            "overrides": [(num(o.get(q("w:ilvl"))), val_of(o, "w:startOverride"))
                          for o in findall(n, "w:lvlOverride")],
        }
    return abstracts, nums


def render_cascade(levels, depth=4):
    """'1. -> a. -> i. -> (a)' from the lvlText plus numFmt."""
    out = []
    for lv in levels[:depth]:
        if lv["fmt"] == "bullet":
            out.append("bullet")
            continue
        t = lv.get("text") or ""
        out.append(re.sub(r"%\d", FMT_SAMPLE.get(lv["fmt"], "?"), t) or "?")
    return " -> ".join(out)


# --------------------------------------------------------------------------- #
# body
# --------------------------------------------------------------------------- #
def read_rels(zf, part):
    folder, _, base = part.rpartition("/")
    path = "%s/_rels/%s.rels" % (folder, base) if folder else "_rels/%s.rels" % base
    if path not in zf.namelist():
        return {}
    root = ET.fromstring(zf.read(path))
    return {rel.get("Id"): rel.get("Target") for rel in root}


def classify_overrides(p):
    """Split direct formatting into Word noise vs a human actually overriding."""
    noise, real = set(), set()
    ppr = find(p, "w:pPr")
    if ppr is not None:
        for c in ppr:
            n = local(c.tag)
            if n in ("pStyle", "sectPr"):
                continue
            (real if n in MEANINGFUL_PROPS else noise).add(n)
    for run in findall(p, "w:r"):
        rpr = find(run, "w:rPr")
        if rpr is None:
            continue
        for c in rpr:
            n = local(c.tag)
            (real if n in MEANINGFUL_PROPS else noise).add(n)
    return noise, real


def read_body(zf, styles, redact):
    root = ET.fromstring(zf.read("word/document.xml"))
    body = find(root, "w:body")
    rels = read_rels(zf, "word/document.xml")

    blocks = []
    section_index = 0
    usage = Counter()
    noise_counter = Counter()
    real_counter = Counter()
    hand_formatted = 0
    total_paras = 0

    def walk(container, depth=0):
        nonlocal section_index, hand_formatted, total_paras
        for child in container:
            tag = local(child.tag)
            if tag == "p":
                total_paras += 1
                ppr = find(child, "w:pPr")
                sid = val_of(ppr, "w:pStyle") or "Normal"
                usage[sid] += 1
                st = styles.get(sid, {})
                raw = text_of(child)
                noise, real = classify_overrides(child)
                for n in noise:
                    noise_counter[n] += 1
                for n in real:
                    real_counter[n] += 1
                if real:
                    hand_formatted += 1
                npr = find(ppr, "w:numPr")
                is_heading = (st.get("outline") is not None
                              or bool(re.match(r"(?i)^heading\s*\d", st.get("name", ""))))
                blocks.append({
                    "kind": "heading" if is_heading else "para",
                    "section": section_index,
                    "style": sid,
                    "style_name": st.get("name", sid),
                    "text": ("<len=%d>" % len(raw)) if (redact and not is_heading and raw.strip()) else raw,
                    "numId": val_of(npr, "w:numId") if npr is not None else "",
                    "ilvl": val_of(npr, "w:ilvl") if npr is not None else "",
                    "overrides": ",".join(sorted(real)),
                    "noise": ",".join(sorted(noise)),
                    "image": "yes" if list(child.iter(q("w:drawing"))) else "",
                    "field": " ".join(t.text or "" for t in child.iter(q("w:instrText"))).strip(),
                })
                if find(ppr, "w:sectPr") is not None:
                    section_index += 1
            elif tag == "tbl":
                rows = findall(child, "w:tr")
                cols = len(findall(child, "w:tblGrid/w:gridCol"))
                blocks.append({
                    "kind": "table", "section": section_index,
                    "style": val_of(find(child, "w:tblPr"), "w:tblStyle") or "",
                    "style_name": "", "text": "table %dx%d" % (len(rows), cols),
                    "numId": "", "ilvl": "", "overrides": "", "noise": "",
                    "image": "", "field": "",
                })
                for tc in child.iter(q("w:tc")):
                    for p in findall(tc, "w:p"):
                        usage[val_of(find(p, "w:pPr"), "w:pStyle") or "Normal"] += 1
            elif tag == "sdt":
                pr = find(child, "w:sdtPr")
                blocks.append({
                    "kind": "control", "section": section_index,
                    "style": "", "style_name": "",
                    "text": "[content control tag=%s alias=%s]" % (
                        val_of(pr, "w:tag"), val_of(pr, "w:alias")),
                    "numId": "", "ilvl": "", "overrides": "", "noise": "",
                    "image": "", "field": "",
                })
                content = find(child, "w:sdtContent")
                if content is not None and depth < 4:
                    walk(content, depth + 1)
            elif tag == "sectPr":
                section_index += 1

    walk(body)

    sections = []
    for sect in body.iter(q("w:sectPr")):
        pgsz = find(sect, "w:pgSz")
        pgmar = find(sect, "w:pgMar")
        pgnum = find(sect, "w:pgNumType")
        refs = []
        for tag, kind in (("w:headerReference", "hdr"), ("w:footerReference", "ftr")):
            for ref in findall(sect, tag):
                refs.append("%s/%s=%s" % (kind, ref.get(q("w:type")),
                                          rels.get(ref.get(q("r:id")), "?")))
        sections.append({
            "size": "%sx%s" % (twips_in(pgsz.get(q("w:w"))) if pgsz is not None else "?",
                               twips_in(pgsz.get(q("w:h"))) if pgsz is not None else "?"),
            "margins": ("t%s b%s l%s r%s" % tuple(
                twips_in(pgmar.get(q("w:" + k))) for k in ("top", "bottom", "left", "right"))
                if pgmar is not None else "?"),
            "titlePg": find(sect, "w:titlePg") is not None,
            "pgnum": ("start=%s fmt=%s" % (pgnum.get(q("w:start")), pgnum.get(q("w:fmt")))
                      if pgnum is not None else ""),
            "refs": refs,
        })

    return {
        "blocks": blocks, "usage": usage, "sections": sections,
        "noise": noise_counter, "real": real_counter,
        "hand_formatted": hand_formatted, "total_paras": total_paras,
    }


# --------------------------------------------------------------------------- #
# report
# --------------------------------------------------------------------------- #
def build_report(src, styles, dd_run, dd_para, abstracts, nums, body):
    L = []
    add = L.append
    usage = body["usage"]
    total = body["total_paras"]
    hand = body["hand_formatted"]

    add("# %s: the basics" % src)
    add("")

    add("## 1. Baseline")
    add("")
    add("- Document default run: **%s**" % (dd_run or "not set"))
    add("- Document default paragraph: **%s**" % (dd_para or "not set"))
    add("- Body paragraphs: %d" % total)
    add("- Sections: %d" % len(body["sections"]))
    add("")

    add("## 2. Is it really hand formatted?")
    add("")
    add("Direct formatting split into properties a human sets on purpose versus "
        "tags Word writes by itself.")
    add("")
    add("- Paragraphs with **meaningful** overrides: **%d of %d (%.1f%%)**"
        % (hand, total, 100.0 * hand / total if total else 0))
    add("")
    add("| property | paragraphs | verdict |")
    add("|---|---|---|")
    for prop, n in body["real"].most_common():
        add("| `%s` | %d | real override |" % (prop, n))
    for prop, n in body["noise"].most_common(8):
        add("| `%s` | %d | Word noise, ignore |" % (prop, n))
    add("")
    add("If `ind` and `spacing` dominate the real list, the hand formatting is "
        "mostly indents and gaps, which config can absorb as numbers. If `sz`, "
        "`b` and `rFonts` dominate, fonts were set per paragraph and the styles "
        "cannot be trusted as the source of truth.")
    add("")

    add("## 3. Styles actually in use")
    add("")
    add("Only styles that appear in the body, plus custom styles. Everything "
        "Word ships unused is dropped.")
    add("")
    add("| uses | id | name | based on | outline | paragraph | run |")
    add("|---|---|---|---|---|---|---|")
    shown = set()
    for sid, n in usage.most_common():
        st = styles.get(sid, {"name": sid, "basedOn": "", "outline": "",
                              "ppr": "", "rpr": "", "custom": False})
        shown.add(sid)
        add("| %d | `%s` | %s%s | %s | %s | %s | %s |" % (
            n, sid, st.get("name", sid), " **(custom)**" if st.get("custom") else "",
            st.get("basedOn") or "", st.get("outline") or "",
            st.get("ppr", ""), st.get("rpr", "")))
    add("")
    unused_custom = [s for sid, s in styles.items()
                     if s.get("custom") and sid not in shown
                     and s.get("type") == "paragraph"]
    if unused_custom:
        add("### Custom styles defined but not used in the body (%d)"
            % len(unused_custom))
        add("")
        add("| id | name | paragraph | run |")
        add("|---|---|---|---|")
        for s in sorted(unused_custom, key=lambda x: x["name"]):
            add("| `%s` | %s | %s | %s |" % (s["id"], s["name"], s["ppr"], s["rpr"]))
        add("")
        add("These are the interesting ones. Somebody built them on purpose. "
            "If a name here matches a section you need, that is the style to map to.")
        add("")

    add("## 4. Heading style ladder")
    add("")
    heads = [(sid, s) for sid, s in styles.items()
             if s.get("outline") is not None and s.get("type") == "paragraph"]
    heads.sort(key=lambda kv: (int(kv[1]["outline"]), kv[0]))
    add("| outline | id | name | uses | inherits | paragraph | run |")
    add("|---|---|---|---|---|---|---|")
    for sid, s in heads:
        add("| %s | `%s` | %s | %d | %s | %s | %s |" % (
            s["outline"], sid, s["name"], usage.get(sid, 0),
            " < ".join(inherit_chain(styles, sid)[1:]) or "-",
            s["ppr"], s["rpr"]))
    add("")

    add("## 5. Numbering cascades")
    add("")
    used_nums = {b["numId"] for b in body["blocks"] if b["numId"]}
    style_nums = {s["numId"] for s in styles.values() if s.get("numId")}
    live = used_nums | style_nums
    add("numIds referenced by body paragraphs: %s"
        % (", ".join(sorted(used_nums, key=lambda x: int(x))) or "none"))
    add("")
    add("numIds referenced by style definitions: %s"
        % (", ".join(sorted(style_nums, key=lambda x: int(x))) or "none"))
    add("")
    multi = []
    for aid, ab in sorted(abstracts.items(), key=lambda kv: kv[0] or 0):
        refs = [str(n["numId"]) for n in nums.values() if n["abstract"] == aid]
        in_use = bool(set(refs) & live)
        real_levels = [lv for lv in ab["levels"] if lv["fmt"] != "none"]
        if len(real_levels) > 1:
            multi.append((aid, ab, refs, in_use))
        marker = " **<- IN USE**" if in_use else ""
        add("- abstract %s (%s, %d levels) numIds=%s: `%s`%s" % (
            aid, ab["multi"], len(ab["levels"]), refs or "-",
            render_cascade(ab["levels"]), marker))
    add("")
    if multi:
        add("### Multi level definitions, expanded")
        add("")
        for aid, ab, refs, in_use in multi:
            add("**abstract %s** numIds=%s%s" % (aid, refs or "-",
                                                 "  IN USE" if in_use else ""))
            add("")
            add("| lvl | format | lvlText | renders | start | left | hang | tied to style | font |")
            add("|---|---|---|---|---|---|---|---|---|")
            for lv in ab["levels"]:
                add("| %s | %s | `%s` | %s | %s | %s | %s | %s | %s |" % (
                    lv["ilvl"], lv["fmt"], lv["text"],
                    re.sub(r"%\d", FMT_SAMPLE.get(lv["fmt"], "?"), lv["text"] or "")
                    if lv["fmt"] != "bullet" else "bullet",
                    lv["start"], lv["left"], lv["hang"],
                    lv["style"] or "", lv["font"] or ""))
            add("")

    add("## 6. Sections and header/footer map")
    add("")
    add("| # | page | margins | diff 1st pg | page numbering | header/footer parts |")
    add("|---|---|---|---|---|---|")
    for i, s in enumerate(body["sections"]):
        add("| %d | %s | %s | %s | %s | %s |" % (
            i, s["size"], s["margins"], s["titlePg"], s["pgnum"],
            "<br>".join(s["refs"]) or "-"))
    add("")
    add("Appending content to the end of this template lands it in the LAST "
        "section and inherits that section's headers and page numbering. If the "
        "last section is a glossary or appendix, that is the wrong place to "
        "write body content into.")
    add("")

    add("## 7. Body spine")
    add("")
    add("Headings only. Full detail including every paragraph is in worksheet.tsv.")
    add("")
    for i, b in enumerate(body["blocks"]):
        if b["kind"] == "heading":
            add("%4d  s%-2d  `%s`  %s" % (i, b["section"], b["style"], b["text"][:110]))
    add("")

    return "\n".join(L)


def write_worksheet(path, blocks):
    with open(path, "w", newline="", encoding="utf-8") as fh:
        w = csv.writer(fh, delimiter="\t")
        w.writerow(["idx", "section", "kind", "style", "style_name", "numId",
                    "ilvl", "overrides", "image", "field", "text",
                    "DISPOSITION", "MAPS_TO_SECTION", "NOTES"])
        for i, b in enumerate(blocks):
            w.writerow([i, b["section"], b["kind"], b["style"], b["style_name"],
                        b["numId"], b["ilvl"], b["overrides"], b["image"],
                        b["field"], b["text"].replace("\t", " ")[:400],
                        "", "", ""])


def main(argv=None):
    ap = argparse.ArgumentParser(description="Basic formatting facts from a .docx template.")
    ap.add_argument("template")
    ap.add_argument("-o", "--outdir", default=None)
    ap.add_argument("--redact", action="store_true",
                    help="mask non-heading body text")
    args = ap.parse_args(argv)

    path = Path(args.template).expanduser()
    if not path.is_file():
        raise SystemExit("Not a file: %s" % path)
    outdir = Path(args.outdir) if args.outdir else path.with_name(path.stem + "_basics")
    outdir.mkdir(parents=True, exist_ok=True)

    with zipfile.ZipFile(path) as zf:
        if "word/document.xml" not in zf.namelist():
            raise SystemExit("No word/document.xml. Save as .docx first.")
        styles_root = (ET.fromstring(zf.read("word/styles.xml"))
                       if "word/styles.xml" in zf.namelist() else None)
        numbering_root = (ET.fromstring(zf.read("word/numbering.xml"))
                          if "word/numbering.xml" in zf.namelist() else None)
        styles = read_styles(styles_root)
        dd_run, dd_para = doc_defaults(styles_root)
        abstracts, nums = read_numbering(numbering_root)
        body = read_body(zf, styles, args.redact)

    (outdir / "basics.md").write_text(
        build_report(path.name, styles, dd_run, dd_para, abstracts, nums, body),
        encoding="utf-8")
    write_worksheet(outdir / "worksheet.tsv", body["blocks"])

    total = body["total_paras"]
    hand = body["hand_formatted"]
    print("wrote %s" % (outdir / "basics.md"))
    print("wrote %s  (%d rows to annotate)" % (outdir / "worksheet.tsv",
                                               len(body["blocks"])))
    print("\nreal hand formatting: %d of %d paragraphs (%.1f%%)"
          % (hand, total, 100.0 * hand / total if total else 0))
    print("top real overrides: %s" % ", ".join(
        "%s=%d" % (k, v) for k, v in body["real"].most_common(5)))
    print("styles in use: %d of %d defined" % (len(body["usage"]), len(styles)))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
