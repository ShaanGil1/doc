        <mxCell id="raw" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#02548B;strokeColor=none;fontColor=#ffffff;fontSize=12;arcSize=10;verticalAlign=top;spacingTop=0;spacingLeft=10;spacingRight=10;spacingBottom=10;" value="" vertex="1">
