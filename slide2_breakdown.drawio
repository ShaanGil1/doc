        <mxCell id="context_field1" parent="1" style="text;html=1;fontSize=10;fontColor=#cccccc;align=left;fontFamily=Helvetica;whiteSpace=wrap;" value="Policy governing end-of-fiscal-year physical inventory counting and reconciliation. Six-step process:&amp;nbsp;&lt;div&gt;(1) warehouse physical couny&lt;/div&gt;&lt;div&gt;(2) compare against system records&lt;/div&gt;&lt;div&gt;(3) investigate discrepancies&lt;br&gt;(4) submit adjustments to finance&lt;/div&gt;&lt;div&gt;(5) finance posts adjustments before deadline&lt;/div&gt;&lt;div&gt;(6) report numbers up Must align with SFFAS XX for inventory valuation&lt;br&gt;and SFFAS XX for cost recognition.&lt;/div&gt;" vertex="1">
          <mxGeometry height="107.5" width="360" x="469" y="92.5" as="geometry" />
        </mxCell>
        <mxCell id="context_field2_label" parent="1" style="text;html=1;fontSize=10;fontColor=#9b59b6;fontStyle=1;align=left;" value="&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Ambiguities:&lt;/font&gt;" vertex="1">
